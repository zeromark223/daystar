# Daystar configuration: every environment variable the server reads.
#
# Everything is commented out. Copy this file to .env (Bun loads .env
# automatically), then uncomment the lines you need and fill in their values.
# A variable left commented takes its default. In Coolify, set the same
# variables on the application instead of shipping a .env file.
#
# Minimum for a public server: ROOM_SECRET and HEALTH_TOKEN.

# =============================================================================
# Server
# =============================================================================

# Port to listen on (in cluster mode, the agent's port). Default 3000.
# PORT=3000

# Address to bind. Default 0.0.0.0 (every interface).
# HOST=0.0.0.0

# Secret that signs host keys. Without it a random one is made at startup and
# hosts lose their rooms on restart. Generate: openssl rand -base64 32
# ROOM_SECRET=

# Bearer token required by GET /api/health (Authorization: Bearer <token>, or
# ?token=). Commented out: /api/health is open.
# HEALTH_TOKEN=

# Unlocks the developer chat commands (/dev <token>). Commented out: a random
# one is generated and printed at startup.
# DEV_TOKEN=

# 1 prints a JSON line of server stats every second.
# LOG_STATS=1

# Optional HTTPS, standalone only, e.g. to test voice from a phone on the LAN
# (browsers allow the microphone only on secure pages). Set both or neither:
# paths to a PEM certificate and its private key.
# TLS_CERT=dev-cert.pem
# TLS_KEY=dev-key.pem

# =============================================================================
# Capacity and load
# =============================================================================

# Outgoing bandwidth (Mbit/s) to stay under: the server lowers the snapshot
# rate as it gets close. Commented out: CPU load only.
# EGRESS_BUDGET_MBPS=900

# Unsent bytes per socket before Bun drops frames for it. Default 16 MB.
# WS_BACKPRESSURE_LIMIT=16777216

# A/B tests only: a fixed room tick rate (1-100) and number of snapshot groups
# (1 or 2) instead of the automatic schedule.
# SNAPSHOT_TICK_HZ=40
# SNAPSHOT_GROUPS=2

# =============================================================================
# Cluster (docs/cluster.md): leave this section commented for one standalone
# server.
# =============================================================================

# Number of game servers the supervisor starts next to the agent.
# Default 0 = standalone.
# CLUSTER_SERVERS=4

# Shared HMAC key for tickets, mesh links and host keys (replaces ROOM_SECRET
# in a cluster). Commented out: random per container, so hosts lose their rooms
# on restart. Generate: openssl rand -base64 32
# CLUSTER_SECRET=

# Players per game server at 100% load; tune per machine with the load test.
# Default 2000.
# SERVER_CAPACITY=2000

# Port of the first game server; the others follow. Default PORT + 1.
# SERVER_BASE_PORT=3001

# WebSocket URL clients use to reach a game server; {id} and {port} are
# replaced. Default ws://localhost:{port}/ws.
# SERVER_PUBLIC_URL_TEMPLATE=wss://s{id}.example.com/ws

# =============================================================================
# Postgres (needed for accounts): the standard libpq variables, read by Bun.sql.
# =============================================================================

# Database host name or IP. Commented out: no database, accounts off.
# PGHOST=10.0.0.10
# PGPORT=5432

# One database per environment, e.g. daystar_dev and daystar_prod.
# PGDATABASE=daystar_dev

# A role that owns only this database, not a superuser.
# PGUSER=daystar_dev
# PGPASSWORD=

# disable on a private network (e.g. Coolify's internal one); require when
# connecting over the internet.
# PGSSLMODE=disable

# =============================================================================
# Accounts (experiment): log in with Authentik. Off unless OIDC_ISSUER is set;
# guests never need an account. When on, every variable below is required, and
# so is PGHOST above.
# =============================================================================

# Origin of the site as people open it: cookies, redirects and the Origin
# check. In production e.g. https://daystar.example.com.
# PUBLIC_URL=http://localhost:5173

# Issuer of the Daystar provider in Authentik, with the trailing slash.
# OIDC_ISSUER=https://auth.example.com/application/o/daystar/

# Client ID and secret of that OAuth2/OpenID provider (Authentik: Applications
# > Providers; client type Confidential).
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# PUBLIC_URL + /api/auth/callback; must be on PUBLIC_URL and listed in the
# provider's redirect URIs.
# OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Signs Daystar's access tokens and the login cookie; at least 32 characters.
# Changing it signs everyone out. Generate: openssl rand -base64 48
# AUTH_JWT_SECRET=

# Lifetime of an access token in seconds (the client refreshes a minute before
# it ends). Default 900.
# AUTH_ACCESS_TTL=900

# How many days someone stays signed in without visiting. Default 30.
# AUTH_REFRESH_TTL_DAYS=30
