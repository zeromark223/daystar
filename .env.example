# Copy to .env (Bun loads it automatically) and fill in. In Coolify, set the same
# variables on the application instead. Everything is optional unless noted.

# --- Server -------------------------------------------------------------------
# Secret behind host keys; without it hosts lose their rooms on restart.
ROOM_SECRET=
# Bearer token for GET /api/health.
HEALTH_TOKEN=
# Public origin of the site, used for OIDC redirects and the WebSocket Origin check.
PUBLIC_URL=http://localhost:5173

# --- Postgres -------------------------------------------------------------------
# Standard libpq variables (Bun.sql reads them directly).
PGHOST=
PGPORT=5432
PGDATABASE=daystar
PGUSER=daystar
PGPASSWORD=
# disable on Coolify's internal network; require when connecting over the internet.
PGSSLMODE=disable

# --- Authentik (OIDC) -------------------------------------------------------------
# Issuer of the Daystar provider, e.g. https://auth.example.com/application/o/daystar/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must be listed in the provider's redirect URIs.
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback

# --- Daystar sessions (JWT) -------------------------------------------------------
# Signs Daystar's own access tokens; at least 32 random bytes:
#   openssl rand -base64 48
AUTH_JWT_SECRET=
# Access token lifetime (seconds) and refresh token lifetime (days).
AUTH_ACCESS_TTL=900
AUTH_REFRESH_TTL_DAYS=30
