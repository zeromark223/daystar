{
  "name": "daystar",
  "version": "0.1.0",
  "description": "A meeting space in orbit: each person is a glowing star or planet around a shared sun. Move freely, chat.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun --watch server/src/main.ts",
    "dev:client": "bun --bun vite --config client/vite.config.ts",
    "build": "bun --bun vite build --config client/vite.config.ts",
    "start": "bun server/src/main.ts",
    "typecheck": "tsc -p client && tsc -p server",
    "test": "bun test",
    "loadtest": "bun tools/loadtest.ts",
    "cluster": "CLUSTER_SERVERS=4 bun server/src/supervisor.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5",
    "pixi.js": "^8.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
