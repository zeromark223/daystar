{
  "name": "cute-meeting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "node server/src/index.ts",
    "typecheck": "tsc -p client && tsc -p server",
    "test": "node --test \"shared/**/*.test.ts\" \"server/**/*.test.ts\"",
    "assets": "python3 tools/build_sprites.py",
    "loadtest": "node tools/loadtest.ts"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "pixi.js": "^8.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
